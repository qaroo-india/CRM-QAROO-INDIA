{
  "name": "@ims/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "start:prod": "node dist/migrate.js && node dist/seed.js && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:demo": "tsx src/db/demo.ts",
    "db:demo:campus": "tsx src/db/demo-campus.ts",
    "db:backup": "tsx src/db/backup.ts",
    "db:backup:prod": "node dist/backup.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ims/shared": "*",
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
