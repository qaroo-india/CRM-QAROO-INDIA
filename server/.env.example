# -----------------------------------------------------------------------------
# Server environment -- copy to server/.env and adjust.
#   cp server/.env.example server/.env
#
# NEVER commit server/.env. It is listed in .gitignore.
# Every variable is validated at startup (src/config/env.ts); a bad value stops
# the server with a message naming the variable.
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# 127.0.0.1 keeps the dev API off your local network. On Render set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=5000

# Browser origin(s) allowed to call the API with cookies. Comma-separate several.
# Production example: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Reverse proxies in front of the app: 0 locally, 1 on Render.
TRUST_PROXY=0

# SQLite database file, relative to the server/ directory.
DATABASE_URL=./data/institute.db

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Institute defaults -- used ONLY to seed the settings row on first run.
# After that, edit them in the app's Settings screen.
INSTITUTE_NAME=Course Institute
INSTITUTE_TIMEZONE=Asia/Kolkata
INSTITUTE_CURRENCY=INR
INSTITUTE_LOCALE=en-IN

# Flood guard per client IP: requests allowed per window. Keep it well above
# normal use (an office shares one address); sign-in has its own strict limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# -----------------------------------------------------------------------------
# Added in later milestones -- not read by the server yet.
# -----------------------------------------------------------------------------
# Milestone 2 (authentication). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# OWNER_EMAIL=
# OWNER_INITIAL_PASSWORD=
#
# Milestone 8 (email reports)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
