# -----------------------------------------------------------------------------
# Server environment -- copy to server/.env and adjust.
#   cp server/.env.example server/.env
#
# NEVER commit server/.env. It is listed in .gitignore.
# Every variable is validated at startup (src/config/env.ts); a bad value stops
# the server with a message naming the variable.
#
# On Vercel, set these in Project Settings instead; see docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------------

# development | test | production   (Vercel: production by default)
NODE_ENV=development

# 127.0.0.1 keeps the dev API off your local network. On Render set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=5000

# Browser origin(s) allowed to call the API with cookies. Comma-separate several.
# Not needed on Vercel, where the web app and API share one domain.
CLIENT_URL=http://localhost:5173

# Reverse proxies in front of the app: 0 locally, 1 on Vercel (the default there).
TRUST_PROXY=0

# Database. Locally: a SQLite file, relative to the server/ directory.
# Production: a hosted Turso database, libsql://<name>-<org>.turso.io
# (Vercel's Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN,
# which are used when these two are not set.)
DATABASE_URL=./data/institute.db
# DATABASE_AUTH_TOKEN=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Institute defaults -- used ONLY to seed the settings row on first run.
# After that, edit them in the app's Settings screen.
INSTITUTE_NAME=Course Institute
INSTITUTE_TIMEZONE=Asia/Kolkata
INSTITUTE_CURRENCY=INR
INSTITUTE_LOCALE=en-IN

# Flood guard per client IP: requests allowed per window. Keep it well above
# normal use (an office shares one address); sign-in has its own strict limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Sign-in. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses the development defaults.
# JWT_ACCESS_SECRET=
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_INITIAL_PASSWORD=

# Files. local = STORAGE_DIR on this machine; blob = a PRIVATE Vercel Blob store
# (chosen automatically when BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN is set).
# STORAGE_DRIVER=local
STORAGE_DIR=./storage
# MAX_UPLOAD_MB=10

# Email: smtp | log (development: log only) | disabled
EMAIL_TRANSPORT=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# APP_URL=http://localhost:5173

# Background jobs on in-process timers (a long-running server).
JOBS_ENABLED=true
# Vercel Cron calls /api/v1/cron/tick with "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=
