{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@ims/shared": ["./src/shared/index.ts"],
      "@ims/shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ]
}
