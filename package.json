{
  "name": "institute-management",
  "private": true,
  "version": "0.1.0",
  "description": "Unified Course Institute Management, Business Intelligence, and Placement Platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "tsx watch --clear-screen=false src/server/server.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "start:prod": "node dist/migrate.js && node dist/seed.js && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:demo": "tsx src/server/db/demo.ts",
    "db:demo:campus": "tsx src/server/db/demo-campus.ts",
    "db:backup": "tsx src/server/db/backup.ts",
    "db:backup:prod": "node dist/backup.js",
    "db:studio": "drizzle-kit studio",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@libsql/client": "0.18.0",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.104.1",
    "@vercel/blob": "2.8.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "firebase": "^13.2.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "lenis": "1.3.26",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-is": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "npm-run-all2": "9.0.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
