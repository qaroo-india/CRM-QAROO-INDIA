{
  "name": "institute-management",
  "private": true,
  "version": "0.1.0",
  "description": "Course institute management, business intelligence and placement platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:demo": "npm run db:demo --workspace=server",
    "db:demo:campus": "npm run db:demo:campus --workspace=server",
    "db:backup": "npm run db:backup --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "npm-run-all2": "9.0.3",
    "typescript": "7.0.2"
  }
}
