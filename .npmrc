# Dependencies' install scripts are not run.
#
# Why: better-sqlite3 ships prebuilt binaries for Windows, macOS and Linux,
# but npm, installing from package-lock.json, ignores its "gypfile": false
# and tries to compile it with node-gyp -- which fails on machines without
# Visual Studio / build tools. No dependency here needs its install script
# (esbuild finds its platform binary without its postinstall), and skipping
# third-party install scripts is also a supply-chain safeguard.
#
# `npm run <script>` is unaffected. If you add a dependency that really needs
# an install step, run it explicitly: `npm rebuild <package>`.
ignore-scripts=true
