# Dependencies' install scripts are not run.
#
# Why: skipping third-party install scripts is a supply-chain safeguard, and
# no dependency here needs one. The native ones (libSQL, Argon2, esbuild)
# ship prebuilt binaries as per-platform packages that npm picks itself, so
# nothing is compiled -- on Windows, macOS, Linux or Vercel's build machines.
#
# `npm run <script>` is unaffected. If you add a dependency that really needs
# an install step, run it explicitly: `npm rebuild <package>`.
ignore-scripts=true
