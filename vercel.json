{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "cd .. && npm ci --workspace=client --workspace=shared --include-workspace-root",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "dist/vercel.js",
      "installCommand": "cd .. && npm ci --workspace=server --workspace=shared --include-workspace-root --include=dev",
      "buildCommand": "npm run build:vercel",
      "functions": {
        "dist/vercel.js": {
          "includeFiles": "{drizzle,assets}/**",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ],
  "crons": [{ "path": "/api/v1/cron/tick", "schedule": "30 1 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Ga8NTPH2XtGDWDxtreRuzJtSXYI5pzDatQR5BqWiUso='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
