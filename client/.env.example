# -----------------------------------------------------------------------------
# Client environment -- copy to client/.env and adjust.
#
# Every VITE_* variable is compiled INTO the public JavaScript bundle and is
# readable by anyone who opens the site. Never put a secret here.
# -----------------------------------------------------------------------------

# Base URL the browser uses for API calls.
#   Development: leave as /api/v1 -- Vite proxies it to the server (same origin).
#   Production:  keep /api/v1 and add a Vercel rewrite to the Render API, so
#                auth cookies stay first-party (see docs/ARCHITECTURE.md).
VITE_API_URL=/api/v1

# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Display name shown before institute settings load.
VITE_APP_NAME=Institute OS
