# -----------------------------------------------------------------------------
# Unified Application Environment Configuration (.env)
# -----------------------------------------------------------------------------
# Copy this file to .env for local development:
#   cp .env.example .env   (or Copy-Item .env.example .env in PowerShell)
#
# NEVER commit your actual .env file.
# On Vercel, configure these in Project Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# Environment mode: development | test | production (Default on Vercel is production)
NODE_ENV=development

# Server Host & Port
HOST=127.0.0.1
PORT=5000

# Client Application URL / CORS Origins (comma-separated if multiple)
# On Vercel, client and API are unified under the same domain.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Reverse Proxy Hops (0 for local development, 1 on Vercel)
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Database Configuration (SQLite / Turso)
# -----------------------------------------------------------------------------
# Development: Local SQLite database file
# Production on Vercel: Hosted SQLite via Turso (libsql://<db>.turso.io)
# Vercel's Turso integration automatically injects TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
DATABASE_URL=./data/institute.db
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# ALLOW_LOCAL_ON_VERCEL=false

# Logging verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Institute Defaults (Initial database seed values)
# -----------------------------------------------------------------------------
INSTITUTE_NAME=Qaroo India Private Limited
INSTITUTE_TIMEZONE=Asia/Kolkata
INSTITUTE_CURRENCY=INR
INSTITUTE_LOCALE=en-IN

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate random 32+ character secret for production:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Initial owner credentials (created during first seed)
OWNER_EMAIL=owner@institute.local
OWNER_NAME=Institute Owner
OWNER_INITIAL_PASSWORD=ChangeMe-Owner-2026

# -----------------------------------------------------------------------------
# File Storage (Local vs Vercel Blob)
# -----------------------------------------------------------------------------
# local = local storage folder (development)
# blob  = private Vercel Blob store (production on Vercel)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# smtp | log (log to terminal in development) | disabled
EMAIL_TRANSPORT=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Institute OS <reports@institute.local>

# -----------------------------------------------------------------------------
# Background Jobs & Vercel Cron
# -----------------------------------------------------------------------------
# In-process timers for long-running server (false on serverless/Vercel)
JOBS_ENABLED=true
# Shared secret for Vercel Cron (/api/v1/cron/tick)
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Frontend (Vite) Environment Variables
# -----------------------------------------------------------------------------
# Every VITE_* variable is bundled into the client browser build.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_APP_NAME=Institute OS

# Google Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyCxaABFscGMDzIblR2zd_ekNMJeJc1ENhE
VITE_FIREBASE_AUTH_DOMAIN=crm-qaroo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crm-qaroo
VITE_FIREBASE_STORAGE_BUCKET=crm-qaroo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=467452778873
VITE_FIREBASE_APP_ID=1:467452778873:web:599a2ee7b2a1235f1fb7a8
VITE_FIREBASE_MEASUREMENT_ID=G-EQGZ1MHJ61
